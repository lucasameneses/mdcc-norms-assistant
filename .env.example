# Ollama Cloud generates and judges the answers; the key stays in .env, never in git.
OLLAMA_API_KEY=
OLLAMA_CHAT_URL=https://ollama.com
CHAT_MODELS=gpt-oss:20b,gpt-oss:120b,gemma4:31b
JUDGE_MODEL=glm-5.3

# Embeddings run locally: Ollama Cloud has no embedding models.
OLLAMA_EMBED_URL=http://localhost:11434
EMBED_MODEL=bge-m3

DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
COLLECTION=mdcc-article
